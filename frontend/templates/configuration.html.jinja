{% extends "base.html.jinja" %}
{% block title %}Configuration{% endblock %}
{% block content %}
  <div id="configuration" class="space-y-6">
    <div>
      <h1>Configuration</h1>
      <p class="text-muted">Startup settings, read only. Edit your configuration file and restart to apply changes.</p>
      <a class="mt-3 inline-block text-accent underline" href="/dashboard/#upstreams-title"
        >View runtime upstreams and export changes →</a
      >
    </div>
    {% for section in model.sections %}
      <section class="panel">
        <h2 class="mb-3 font-semibold">{{ section.title }}</h2>
        <dl>
          {% for entry in section.entries %}
            <div class="config-row">
              <dt class="min-w-0">
                <span class="text-sm font-medium">{{ entry.name }}</span>
                <p class="text-xs text-muted">{{ entry.description }}</p>
              </dt>
              <dd>{{ entry.value }}</dd>
            </div>
          {% endfor %}
        </dl>
      </section>
    {% endfor %}
  </div>
{% endblock %}
