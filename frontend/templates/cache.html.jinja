{% extends "base.html.jinja" %}
{% block title %}Cache{% endblock %}
{% macro duration(seconds) %}{% if seconds >= 3600 %}
  {{ (seconds / 3600) | round(1) }}
  hours
{% elif seconds >= 60 %}
  {{ (seconds / 60) | round(1) }}
  minutes
{% else %}
  {{ seconds }}
  seconds
{% endif %}{% endmacro %}
{% block content %}
  <div class="mb-6">
    <h1>Metadata cache</h1>
    <p class="text-muted">
      Counts are metadata and runtime state entries. NAR file contents are streamed, not cached locally.
    </p>
  </div>
  <p id="refresh-status" class="mb-4 text-sm text-muted" role="status">Updates every 5 seconds.</p>
  <div
    id="cache"
    class="space-y-6"
    hx-get="/dashboard/cache"
    hx-trigger="every 5s"
    hx-target="this"
    hx-swap="outerHTML"
    hx-select="#cache"
  >
    <section>
      <h2 class="mb-3 font-semibold">Active state cache</h2>
      <p class="mb-3 text-sm text-muted">
        In-memory entries used to coordinate requests. Capacity is an entry limit, not disk space.
      </p>
      <div class="grid gap-3 sm:grid-cols-2">
        {% for name, item in [('NAR info state', model.cache.nar_info), ('NAR file state', model.cache.nar_file)] %}
          <div class="panel">
            <h3 class="text-sm font-medium">{{ name }}</h3>
            <p class="metric">
              {{ item.size }} <span class="text-sm font-normal text-muted">/ {{ item.capacity }} entries</span>
            </p>
            <p class="text-xs text-muted">{{ (item.size / item.capacity * 100) | round(1) }}% of capacity</p>
          </div>
        {% endfor %}
      </div>
    </section>
    <section>
      <h2 class="mb-3 font-semibold">Stored metadata</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {% for name, item in [('NAR info metadata', model.store.nar_info), ('NAR file metadata', model.store.nar_file)] %}
          <div class="panel">
            <h3 class="text-sm font-medium">{{ name }}</h3>
            <p class="metric">
              {% if item.size is not none %}
                {{ item.size }} <span class="text-sm font-normal text-muted">entries</span>
              {% else %}
                <span class="text-base">Count unavailable</span>
              {% endif %}
            </p>
            <p class="text-xs text-muted">
              {{ 'In memory · cleared on restart' if item.cache_mode == 'InMemory' else 'Persistent · retained across restarts' }}
              · TTL {{ duration(item.ttl_secs) }}
            </p>
          </div>
        {% endfor %}
      </div>
    </section>
  </div>
{% endblock %}
