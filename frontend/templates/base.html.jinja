<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="htmx-config" content='{"defaultFocusScroll":false,"selfRequestsOnly":true}' />
    <title>{% block title %}Dashboard{% endblock %} · selector4nix</title>
    <link rel="stylesheet" href="/dashboard/static/main.css" />
    <script type="module" src="/dashboard/static/main.js" defer></script>
  </head>
  <body class="min-h-screen" hx-boost="true">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-nav">
        <a href="/dashboard/" class="text-lg font-semibold tracking-tight">selector4nix</a>
        <nav aria-label="Main navigation">
          <a href="/dashboard/">Overview</a><a href="/dashboard/transferring">Transfers</a
          ><a href="/dashboard/cache">Cache</a><a href="/dashboard/configuration">Configuration</a>
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-6xl px-4 py-6" tabindex="-1">{% block content %}{% endblock %}</main>
  </body>
</html>
